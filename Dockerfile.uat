# 1. Build
FROM node:18-alpine as builder
WORKDIR /app

COPY package*.json ./

RUN yarn install

COPY . .

# Inject API URLs lúc build (Vite inline vào bundle)
ARG VITE_API_LOGIN
ARG VITE_API_WALLETCORE
ARG VITE_FEE_API_URL
ARG VITE_API_MERCHANT
ARG VITE_API_URL
ARG VITE_PORT=8000
ARG DEPLOY_VERSION

ENV VITE_API_LOGIN=${VITE_API_LOGIN}
ENV VITE_API_WALLETCORE=${VITE_API_WALLETCORE}
ENV VITE_FEE_API_URL=${VITE_FEE_API_URL}
ENV VITE_API_MERCHANT=${VITE_API_MERCHANT}
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_PORT=${VITE_PORT}
ENV VITE_DEPLOY_VERSION=${DEPLOY_VERSION}

RUN NODE_OPTIONS="--max-old-space-size=4096" yarn build:uat

# 2. Serve
FROM nginx:stable-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=builder /app/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8000

CMD ["nginx", "-g", "daemon off;"]