# 1. Build
FROM node:18-alpine as builder
WORKDIR /app

COPY package*.json ./

RUN yarn install

COPY . .

ENV VITE_APP_NAME=ewallet
ENV VITE_PORT=8000
ENV VITE_IMAGE_URL=https://cms.ewallet.devops.beamewa.com.vn/api/admin
ENV VITE_API_URL=https://cms.ewallet.devops.beamewa.com.vn/api/admin
ENV VITE_API_LOGIN=https://api.ewallet.flexpay.vn/identity/api/v1/admin
ENV VITE_API_WALLETCORE=https://api.ewallet.flexpay.vn/wallet-core/api/v1/admin
ENV VITE_FEE_API_URL=https://api.ewallet.flexpay.vn/fee/api/v1/admin
ENV VITE_API_MERCHANT=https://api.ewallet.flexpay.vn/merchant/api/v1/admin
ENV VITE_ROUTER_BASE_PATH=/secure-panel

ARG DEPLOY_VERSION=1
ENV VITE_DEPLOY_VERSION=${DEPLOY_VERSION}

RUN NODE_OPTIONS="--max-old-space-size=4096" yarn build

# 2. Serve
FROM nginx:stable-alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=builder /app/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8000

CMD ["nginx", "-g", "daemon off;"]