{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ],
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@icons/*": [
        "./src/components/icons/*"
      ],
      "@configs/*": [
        "./src/app/configs/*"
      ],
      "@services/*": [
        "./src/app/services/*"
      ],
      "@slices/*": [
        "./src/app/slices/*"
      ],
      "@type/*": [
        "./src/app/types/*"
      ],
      "@utils/*": [
        "./src/app/utils/*"
      ],
      "@hooks/*": [
        "./src/app/hooks/*"
      ],
      "@languages/*": [
        "./src/app/languages/*"
      ],
      "@constants/*": [
        "./src/app/constants/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@pages/*": [
        "./src/pages/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./src/app/types"
    ]
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
